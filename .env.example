# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://collab:collab@localhost:5432/collab?schema=public"

# JWT signing secret (Faz 1). Generate: openssl rand -base64 48
JWT_SECRET="dev-only-change-me"

# ws-server
WS_PORT=1234
# Max WS frame size in bytes (default 1MB). Yjs sync is incremental, 1MB covers full-state sync for markdown.
# WS_MAX_PAYLOAD=1000000

# web — must match WS_PORT
NEXT_PUBLIC_WS_URL="ws://localhost:1234"
