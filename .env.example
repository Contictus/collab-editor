# Postgres (matches docker-compose.yml; host 5433 — native PG often squats 5432)
DATABASE_URL="postgresql://collab:collab@localhost:5433/collab?schema=public"

# JWT signing secret (Faz 1). Generate: openssl rand -base64 48
JWT_SECRET="dev-only-change-me"

# ws-server
WS_PORT=1234
# Max WS frame size in bytes (default 1MB). Yjs sync is incremental, 1MB covers full-state sync for markdown.
# WS_MAX_PAYLOAD=1000000
# Snapshot the op log after this many updates (default 100). Lower for tests.
# WS_SNAPSHOT_THRESHOLD=100

# web — must match WS_PORT
NEXT_PUBLIC_WS_URL="ws://localhost:1234"

# ---- Go backend (services/api-go, dual-run) ----
# Same port serving /health + /api/* + WS. Runs alongside Node (:1234).
API_PORT=8080
# Point the web editor at Go instead of Node:
# NEXT_PUBLIC_WS_URL="ws://localhost:8080"
