{
  "name": "collab-editor",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,ws -c blue,magenta \"pnpm --filter web dev\" \"pnpm --filter ws-server dev\"",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter db migrate",
    "db:studio": "pnpm --filter db studio",
    "db:generate": "pnpm --filter db generate",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
